{
  "manifest_version": 3,
  "name": "PromptNest",
  "version": "1.0.0",
  "description": "Capturez une idée ou une sélection et retrouvez-la dans PromptNest.",
  "key": "",
  "permissions": ["activeTab", "contextMenus", "identity", "scripting", "storage"],
  "host_permissions": ["https://bccasaeaogizycotdqxc.supabase.co/*"],
  "action": {"default_popup": "popup.html", "default_title": "Enregistrer dans PromptNest", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}},
  "background": {"service_worker": "background.js", "type": "module"},
  "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+P", "mac": "Command+Shift+P"}, "description": "Ouvrir PromptNest"}},
  "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"},
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}
}
